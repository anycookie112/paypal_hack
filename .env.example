# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox) ---
# developer.paypal.com > Apps & Credentials > Sandbox (app linked to a US business sandbox account: the company)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set after deploying: developer.paypal.com > your app > Webhooks
PAYPAL_WEBHOOK_ID=
# A sandbox personal account that receives test payouts (scripts/paypal/payouts.py)
BUYER_EMAIL=

# --- AI model (any OpenAI-compatible endpoint; swap provider by changing these three) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.atria-asi.ai/v1
LLM_MODEL=Atria-Dawn-Preview

# --- App ---
# Public address of the app; PayPal sends the admin back here after a top-up. On Render: https://<app>.onrender.com
APP_URL=http://localhost:5173
