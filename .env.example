# Copy to .env and fill in. Never commit .env.

# --- PayPal (sandbox) ---
# developer.paypal.com > Apps & Credentials > Sandbox (app linked to a US business sandbox account)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Set after deploying: developer.paypal.com > your app > Webhooks
PAYPAL_WEBHOOK_ID=

# --- Kroger (production) ---
# developer.kroger.com > your app (Products + Locations)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Store used for the demo (e.g. 01400513 = Kroger On the Rhine, Cincinnati)
KROGER_LOCATION_ID=01400513

# --- AI model (any OpenAI-compatible endpoint; swap provider by changing these three) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.atria-asi.ai/v1
LLM_MODEL=Atria-Dawn-Preview

# --- App ---
# Public address of the app; PayPal sends customers back here after they approve. On Render: https://<app>.onrender.com
APP_URL=http://localhost:5173
